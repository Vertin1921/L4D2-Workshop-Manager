<?xml version="1.0" encoding="utf-8"?>
<!--
  仓库级 NuGet 配置。
  只声明 nuget.org，避免继承机器上可能存在的私有源 / 代理源导致还原失败。
  还原示例：dotnet restore L4D2ModManager.sln 加 configfile 参数指向本文件。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
