<Window x:Class="L4D2ModManager.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="L4D2 Mod Manager 安装程序"
        Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}">

    <Border Margin="0" BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部标题 -->
            <Border Grid.Row="0" Background="#FF14141A" Padding="20,16">
                <StackPanel Orientation="Horizontal">
                    <Border Width="5" Height="34" CornerRadius="2.5" Background="{StaticResource Accent}" Margin="0,0,14,0" />
                    <StackPanel>
                        <TextBlock x:Name="HeaderText" Text="安装 Left 4 Dead 2 Mod Manager" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="SubHeaderText" Text="Mod 扫描 / 启停 / 分类 / 冲突检测 / 创意工坊下载"
                                   Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 主体 -->
            <StackPanel Grid.Row="1" Margin="20,18,20,0">
                <!-- 安装选项 -->
                <StackPanel x:Name="InstallPanel">
                    <TextBlock Text="安装目录" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" Grid.Column="0" />
                        <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="Browse_Click" />
                    </Grid>

                    <TextBlock x:Name="PathHint" Style="{StaticResource MutedText}" Margin="2,6,0,0" />
                <TextBlock x:Name="EffectivePathText" Style="{StaticResource MutedText}" Margin="2,2,0,0" FontWeight="SemiBold" />

                    <StackPanel Margin="0,14,0,0">
                        <CheckBox x:Name="DesktopCheck" Content="创建桌面快捷方式" IsChecked="True" />
                        <CheckBox x:Name="StartMenuCheck" Content="创建开始菜单快捷方式" IsChecked="True" />
                        <CheckBox x:Name="LaunchCheck" Content="安装完成后立即启动" IsChecked="True" />
                    </StackPanel>
                </StackPanel>

                <!-- 卸载选项 -->
                <StackPanel x:Name="UninstallPanel" Visibility="Collapsed">
                    <TextBlock x:Name="UninstallLocationText" Style="{StaticResource MutedText}" />
                    <CheckBox x:Name="RemoveDataCheck" Content="同时删除配置、数据库与缩略图缓存（%AppData%\L4D2ModManager）"
                              Margin="0,14,0,0" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                               Text="提示：删除用户数据会丢失已保存的 Mod 列表、方案与设置。Mod 文件本身不会被删除。" />
                </StackPanel>

                <!-- 进度 -->
                <StackPanel Margin="0,18,0,0">
                    <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="准备就绪。" />
                </StackPanel>
            </StackPanel>

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,20,20,18">
                <Button x:Name="CancelButton" Content="取消" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="ActionButton" Style="{StaticResource Primary}" Content="开始安装" Click="Action_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
