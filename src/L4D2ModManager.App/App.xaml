<Application x:Class="L4D2ModManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:L4D2ModManager.App.Infrastructure"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 值转换器 -->
            <infra:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <infra:InverseBooleanConverter x:Key="InverseBoolean" />
            <infra:NullToVisibilityConverter x:Key="NullToVisibility" />
            <infra:EnabledStateBrushConverter x:Key="EnabledStateBrush" />
            <infra:CategoryBrushConverter x:Key="CategoryBrush" />
            <infra:DownloadStatusBrushConverter x:Key="DownloadStatusBrush" />
            <infra:ConflictSeverityBrushConverter x:Key="ConflictSeverityBrush" />
            <infra:CountToVisibilityConverter x:Key="CountToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
