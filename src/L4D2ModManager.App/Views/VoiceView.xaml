<UserControl x:Class="L4D2ModManager.App.Views.VoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             AllowDrop="True" DragOver="View_DragOver" Drop="View_Drop">

    <UserControl.Resources>
        <!-- 角色卡片：头像 + 名字 + 状态 + 按钮 -->
        <DataTemplate x:Key="VoiceCardTemplate">
            <Border Style="{StaticResource Card.Item}" Padding="12" Margin="0,0,12,12" Width="470">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 人物缩略图：有自定义图片就用图片，否则用首字母色牌 -->
                    <Grid Grid.Column="0" Width="56" Height="56" VerticalAlignment="Top">
                        <Border CornerRadius="28" Background="{Binding Accent}" Opacity="0.85" />
                        <TextBlock Text="{Binding Initial}" FontSize="24" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        <Image Source="{Binding AvatarImage}" Stretch="UniformToFill"
                               Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}">
                            <Image.Clip>
                                <EllipseGeometry Center="28,28" RadiusX="28" RadiusY="28" />
                            </Image.Clip>
                        </Image>
                        <!-- 是否被修改过 -->
                        <Border Width="12" Height="12" CornerRadius="6" Background="#28C840"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderThickness="2"
                                BorderBrush="#FF14141A"
                                Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding EnglishName}" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Text}" />
                            <TextBlock Text="{Binding ChineseName}" FontSize="12.5" Margin="6,0,0,0"
                                       Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                            <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" Background="#26FFFFFF" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Codename}" FontSize="10" FontFamily="{StaticResource Font.Mono}"
                                           Foreground="{StaticResource Brush.TextDim}" />
                            </Border>
                            <TextBlock Text="{Binding AvatarSourceText}" Style="{StaticResource Text.Muted}" FontSize="10.5"
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       ToolTip="头像保存在数据目录的 Avatars 文件夹里，本地加载，不联网" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.AccentBright}" />
                        <TextBlock Text="{Binding FileCountText}" Style="{StaticResource Text.Muted}" FontSize="11.5" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding DirectoryText}" Style="{StaticResource Text.Muted}" FontSize="11"
                                   Margin="0,3,0,0" TextWrapping="Wrap" />

                        <!-- 按钮行用 WrapPanel：宽度不够时自动换行，绝不溢出卡片 -->
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource Button.Primary}" Content="安装" Padding="12,5" FontSize="12"
                                    Margin="0,0,6,6"
                                    Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" ToolTip="选择语音 Mod（.vpk 优先）并备份后安装" />
                            <Button Style="{StaticResource Button.Ghost}" Content="备份" Padding="12,5" FontSize="12"
                                    Margin="0,0,6,6"
                                    Command="{Binding DataContext.BackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" ToolTip="只备份当前语音，不修改任何文件" />
                            <Button Style="{StaticResource Button.Ghost}" Content="恢复" Padding="12,5" FontSize="12"
                                    Margin="0,0,6,6"
                                    Command="{Binding DataContext.RestoreLatestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" ToolTip="恢复该角色最近一次原版备份" />
                            <Button Style="{StaticResource Button.Ghost}" Content="目录" Padding="12,5" FontSize="12"
                                    Margin="0,0,6,6"
                                    Command="{Binding DataContext.OpenVoiceFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" ToolTip="打开该角色的语音目录" />
                            <Button Style="{StaticResource Button.Ghost}" Content="DLC" Padding="12,5" FontSize="12"
                                    Margin="0,0,6,6"
                                    Command="{Binding DataContext.OpenDlcFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" ToolTip="打开 DLC 里的语音目录" />
                            <Button Style="{StaticResource Button.Ghost}" Content="头像" Padding="12,5" FontSize="12"
                                    Margin="0,0,6,6"
                                    Command="{Binding DataContext.SetAvatarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" ToolTip="选择本地图片作为该角色的头像（网络找不到时用这个）" />
                            <Button Style="{StaticResource Button.Danger}" Content="删除 Mod" Padding="12,5" FontSize="12"
                                    Margin="0,0,0,6"
                                    Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" ToolTip="备份当前状态后恢复安装前的原版备份" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="18,12,18,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!-- 工具与日志区：按内容自适应高度（上限 420），否则按钮换行后会被裁掉、整页也划不到底 -->
            <RowDefinition Height="Auto" MaxHeight="420" />
        </Grid.RowDefinitions>

        <!-- ============ 游戏路径 ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
            <Grid>
                <StackPanel>
                    <TextBlock Text="L4D2 游戏路径" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{Binding GameRootDisplay}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                               Foreground="{StaticResource Brush.Text}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding GamePathStatus}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.TextMuted}" />
                    <TextBlock Text="{Binding AvatarHintText}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.AccentBright}" />
                </StackPanel>

                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource Button.Primary}" Content="🔍  自动检测" Command="{Binding AutoDetectCommand}" />
                    <Button Style="{StaticResource Button.Ghost}" Content="📂  浏览 left4dead2.exe" Margin="8,0,0,8"
                            Command="{Binding BrowseExeCommand}" />
                    <Button Style="{StaticResource Button.Ghost}" Content="🔄  刷新" Margin="8,0,0,8" Command="{Binding RefreshCommand}" />
                    <Button Style="{StaticResource Button.Primary}" Content="⬇  下载人物头像" Margin="8,0,0,8"
                            Command="{Binding DownloadAvatarsCommand}"
                            ToolTip="从社区维基抓取八名生还者的头像并缓存到本机（也可自己替换）" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ============ 拖放提示 + 状态 ============ -->
        <Border Grid.Row="1" Style="{StaticResource Card.Static}" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="{Binding DragHintText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="安装方式：① .vpk 语音包 → 放进 left4dead2\addons 作为 addon 加载（不覆盖游戏内的语音文件）；② 散装文件夹（sound\player\survivor\voice\…）→ 先 ZIP 备份原版，再用你的文件覆盖游戏语音目录。" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" MinWidth="205">
                    <Button Style="{StaticResource Button.Primary}" Content="📂  选择 Mod 文件（.vpk）"
                            Command="{Binding ChooseModFileCommand}" />
                    <Button Style="{StaticResource Button.Ghost}" Content="📁  选择 Mod 文件夹" Margin="0,8,0,0"
                            Command="{Binding ChooseModFolderCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 角色列表 + 备份管理 ============ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="一代生还者" Style="{StaticResource Text.Title}" Margin="2,4,0,8" />
                <ItemsControl ItemsSource="{Binding L4D1Cards}" ItemTemplate="{StaticResource VoiceCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="二代生还者" Style="{StaticResource Text.Title}" Margin="2,14,0,8" />
                <ItemsControl ItemsSource="{Binding L4D2Cards}" ItemTemplate="{StaticResource VoiceCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- 备份管理 -->
                <Border Style="{StaticResource Card.Static}" Padding="14" Margin="0,16,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="备份管理" Style="{StaticResource Text.Section}" />
                            <Button Style="{StaticResource Button.Ghost}" Content="📂 打开备份目录" Margin="12,0,0,0" Padding="10,4"
                                    FontSize="12" Command="{Binding OpenBackupsFolderCommand}" />
                            <Button Style="{StaticResource Button.Ghost}" Content="📂 打开数据目录" Margin="6,0,0,0" Padding="10,4"
                                    FontSize="12" Command="{Binding OpenDataFolderCommand}" />
                            <Button Style="{StaticResource Button.Ghost}" Content="🗑 清除头像缓存" Margin="6,0,0,0" Padding="10,4"
                                    FontSize="12" Command="{Binding ClearAvatarsCommand}"
                                    ToolTip="删除本机已缓存的头像图片（抓错了用这个清掉再重下）" />
                            <Button Style="{StaticResource Button.Ghost}" Content="🖼 头像目录" Margin="6,0,0,0" Padding="10,4"
                                    FontSize="12" Command="{Binding OpenAvatarsFolderCommand}"
                                    ToolTip="把角色头像命名为代号（如 mechanic.png）放进该目录即可显示人物缩略图" />
                        </StackPanel>

                        <TextBlock Text="{Binding SelectedBackupDetail}" Style="{StaticResource Text.Muted}" Margin="0,8,0,8"
                                   TextWrapping="Wrap" />

                        <!-- 关掉自带滚动：否则鼠标停在备份列表上时滚轮被它吃掉，整页就"划不动"了 -->
                        <ListBox Style="{StaticResource ListBox.Clean}" ItemsSource="{Binding Backups}"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectedItem="{Binding SelectedBackup}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,3">
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                                       Foreground="{StaticResource Brush.Text}" />
                                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource Text.Muted}" FontSize="11.5" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ValidText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="11.5" Foreground="{StaticResource Brush.Warning}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Style="{StaticResource Button.Primary}" Content="↩  恢复选中的备份" Command="{Binding RestoreBackupCommand}" />
                            <Button Style="{StaticResource Button.Ghost}" Content="✅ 验证 ZIP" Margin="8,0,0,8" Command="{Binding VerifyBackupCommand}" />
                            <Button Style="{StaticResource Button.Danger}" Content="🗑 删除备份" Margin="8,0,0,8" Command="{Binding DeleteBackupCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 工具 + 说明 -->
                <Border Style="{StaticResource Card.Static}" Padding="14" Margin="0,12,0,16">
                    <StackPanel>
                        <TextBlock Text="工具与说明" Style="{StaticResource Text.Section}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource Button.Primary}" Content="⬇  下载人物头像" Command="{Binding DownloadAvatarsCommand}"
                                    ToolTip="从社区维基抓取八名生还者的头像并缓存到本机（可自己替换）" />
                            <Button Style="{StaticResource Button.Ghost}" Content="📂 打开游戏目录" Margin="8,0,0,8" Command="{Binding OpenGameFolderCommand}" />
                            <Button Style="{StaticResource Button.Ghost}" Content="📄 打开日志目录" Margin="8,0,0,8" Command="{Binding OpenLogsFolderCommand}" />
                            <Button Style="{StaticResource Button.Primary}" Content="🎧 声音缓存说明" Margin="8,0,0,8" Command="{Binding CacheHelpCommand}" />
                            <Button Style="{StaticResource Button.Ghost}" Content="📋 复制 snd_rebuildaudiocache" Margin="8,0,0,8" Command="{Binding CopyCacheCommand}" />
                            <Button Style="{StaticResource Button.Ghost}" Content="📋 复制 quit" Margin="8,0,0,8" Command="{Binding CopyQuitCommand}" />
                            <Button Style="{StaticResource Button.Ghost}" Content="📁 更改备份位置" Margin="8,0,0,8"
                                    Command="{Binding ChooseBackupFolderCommand}"
                                    ToolTip="{Binding BackupDirectoryText, StringFormat=当前备份位置：{0}}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding CacheNoticeText}" Style="{StaticResource Text.Muted}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding MultiplayerNoticeText}" Style="{StaticResource Text.Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="安全规则：任何替换之前都会先创建原版 ZIP 备份并通过完整性验证；备份失败则立即取消，绝不修改游戏文件。恢复之前也会先把当前状态备份一次。本程序只处理 sound\player\survivor\voice\ 下的语音文件。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ 日志窗口 ============ -->
        <Border Grid.Row="3" Style="{StaticResource Card.Static}" Padding="12,8" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="操作日志" Style="{StaticResource Text.Section}" FontSize="12" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding LogText}" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
