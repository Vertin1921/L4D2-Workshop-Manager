<UserControl x:Class="L4D2ModManager.App.Views.VoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             AllowDrop="True" DragOver="View_DragOver" Drop="View_Drop">

    <Grid Margin="18,14,18,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 说明 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="🎙  人物语音替换" Style="{StaticResource Text.Section}" />
                <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="把语音包文件夹（例如解压出来的 sound\player\zoey\… 或名字里带「佐伊语音」的文件夹）拖进来，程序会按文件夹名与内部路径自动识别角色。1 代角色（Bill / Francis / Louis / Zoey）会同时写入 left4dead2_dlc1、left4dead2_dlc2、left4dead2_dlc3；2 代角色写入 left4dead2。覆盖前会自动备份，之后可一键还原。" />
            </StackPanel>
        </Border>

        <!-- 拖放区 -->
        <Border Grid.Row="1" Style="{StaticResource Card.Static}" Padding="16" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="拖入语音文件夹（或点右侧按钮选择）" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="{Binding SourceDirectory}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                    <TextBlock Text="{Binding DetectionText}" FontSize="12.5" Margin="0,8,0,0"
                               Foreground="{StaticResource Brush.AccentBright}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TargetText}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding GameRootText}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Button Style="{StaticResource Button.Primary}" Content="📂  选择文件夹" Command="{Binding ChooseFolderCommand}" />
                    <TextBlock Text="角色" Style="{StaticResource Text.Muted}" Margin="0,12,0,4" />
                    <ComboBox Style="{StaticResource ComboBox.Dark}" Width="210"
                              ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}"
                              DisplayMemberPath="Text" />
                    <Button Style="{StaticResource Button.Primary}" Content="⬇  开始替换" Margin="0,12,0,0"
                            Command="{Binding ReplaceCommand}" />
                    <TextBlock Text="自动识别不对时可以在这里手动指定角色" Style="{StaticResource Text.Muted}"
                               FontSize="11" Margin="0,6,0,0" MaxWidth="210" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 备份与还原 -->
        <Border Grid.Row="2" Style="{StaticResource Card.Static}" Padding="16,14" Margin="0,0,0,10">
            <Grid>
                <StackPanel>
                    <TextBlock Text="备份与还原" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="{Binding BackupText}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Ghost}" Content="↩  还原此角色" Margin="0,0,8,0"
                            Command="{Binding RestoreCharacterCommand}" />
                    <Button Style="{StaticResource Button.Danger}" Content="↩  还原全部语音" Margin="0,0,8,0"
                            Command="{Binding RestoreAllCommand}" />
                    <Button Style="{StaticResource Button.Ghost}" Content="📂  打开备份目录" Command="{Binding OpenBackupCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 状态 -->
        <Border Grid.Row="3" Style="{StaticResource Card.Static}" Padding="14,10" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                <ProgressBar Style="{StaticResource ProgressBar.Dark}" Height="4" Margin="0,8,0,0" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
