<UserControl x:Class="L4D2ModManager.App.Views.WorkshopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:L4D2ModManager.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:WorkshopViewModel}"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="260" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ================= 浏览器区域 ================= -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 工具栏：左上角固定「下载 Mod」按钮 -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10,9" Margin="0,0,0,8">
                <StackPanel>
                    <WrapPanel>
                        <Button Style="{StaticResource Button.Primary}" Content="⬇  下载 Mod" MinWidth="118"
                                Command="{Binding DownloadCommand}"
                                ToolTip="解析当前工坊物品页并下载（无需先点「获取信息」）" />
                        <Button Style="{StaticResource Button.Ghost}" Content="⬇ 下载合集" Margin="6,0,0,0"
                                Click="DownloadCollection_Click"
                                ToolTip="抓取当前页面上的所有工坊物品（合集页通常含几十个 Mod）并批量加入下载队列" />
                        <Button Style="{StaticResource Button.Icon}" Content="◀" Margin="10,0,8,8" Command="{Binding BackCommand}" ToolTip="后退" />
                        <Button Style="{StaticResource Button.Icon}" Content="▶" Margin="2,0,8,8" Command="{Binding ForwardCommand}" ToolTip="前进" />
                        <Button Style="{StaticResource Button.Icon}" Content="⟳" Margin="2,0,8,8" Command="{Binding ReloadCommand}" ToolTip="刷新" />
                        <Button Style="{StaticResource Button.Icon}" Content="🏠" Margin="2,0,8,8" Command="{Binding HomeCommand}" ToolTip="创意工坊首页" />

                        <Grid MinWidth="180" Width="Auto" Margin="8,0,8,8">
                            <TextBox Style="{StaticResource TextBox.Dark}"
                                     Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="AddressBox_KeyDown" />
                        </Grid>
                        <Button Style="{StaticResource Button.Ghost}" Content="前往" Margin="6,0,8,8" Command="{Binding GoCommand}" />

                        <Grid MinWidth="160" Width="Auto" Margin="10,0,8,8">
                            <TextBox Style="{StaticResource TextBox.Dark}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="SearchBox_KeyDown" />
                            <TextBlock Text="🔍 搜索创意工坊 Mod" Style="{StaticResource Text.Muted}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                        </Grid>
                        <Button Style="{StaticResource Button.Ghost}" Content="搜索" Margin="6,0,8,8" Command="{Binding SearchCommand}" />

                        <Button Style="{StaticResource Button.Ghost}" Content="热门" Margin="8,0,8,8" Command="{Binding BrowseTrendCommand}" />
                        <Button Style="{StaticResource Button.Ghost}" Content="最新" Margin="4,0,8,8" Command="{Binding BrowseRecentCommand}" />
                        <Button Style="{StaticResource Button.Ghost}" Content="最高评分" Margin="4,0,0,8" Command="{Binding BrowseTopRatedCommand}" />
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Muted}" FontSize="11.5"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="620" />
                        <TextBlock Text="{Binding CurrentIdText}" Style="{StaticResource Text.Muted}" FontSize="11.5"
                                   Foreground="{StaticResource Brush.Info}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="下载目录：" Style="{StaticResource Text.Muted}" FontSize="11.5" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DownloadDirectoryText}" Style="{StaticResource Text.Muted}" FontSize="11.5"
                                   Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="380" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 浏览器本体 -->
            <Border Grid.Row="1" CornerRadius="10" Background="#FF0A0A0E"
                    BorderBrush="{StaticResource Brush.BorderSoft}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <wv2:WebView2 x:Name="Browser" Visibility="Collapsed" />

                    <StackPanel x:Name="BrowserPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🛒" FontSize="40" HorizontalAlignment="Center" Opacity="0.6" />
                        <TextBlock x:Name="BrowserPlaceholderText" Text="正在启动内置浏览器…"
                                   Style="{StaticResource Text.Body}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock x:Name="BrowserPlaceholderDetail"
                                   Text="创意工坊页面完全在程序内部显示，不会打开外部浏览器。"
                                   Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                   MaxWidth="420" TextAlignment="Center" />
                    </StackPanel>

                    <Border x:Name="LoadingBar" VerticalAlignment="Top" Height="2" Background="{StaticResource Brush.AccentBright}"
                            Opacity="0" />
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 右侧信息面板 ================= -->
        <Border Grid.Column="1" Width="342" Margin="10,0,0,0" Style="{StaticResource Card}" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="创意工坊信息" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="打开一个 Mod 页面后点击「⬇ 下载 Mod」，或直接粘贴链接 / ID。" Style="{StaticResource Text.Muted}" />

                    <TextBox Style="{StaticResource TextBox.Dark}" Margin="0,10,0,0"
                             Text="{Binding ManualId, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="粘贴 https://steamcommunity.com/sharedfiles/filedetails/?id=... 或纯 ID" />
                    <TextBlock Text="{Binding ManualHint}" Style="{StaticResource Text.Muted}" FontSize="11.5" Margin="2,6,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource Button.Ghost}" Content="获取信息" Command="{Binding FetchInfoCommand}" />
                        <Button Style="{StaticResource Button.Primary}" Content="{Binding DownloadButtonText}" Margin="8,0,0,0"
                                Command="{Binding DownloadCommand}" />
                        <Button Style="{StaticResource Button.Icon}" Content="✕" Margin="6,0,0,0" ToolTip="清空信息"
                                Command="{Binding ClearInfoCommand}"
                                Visibility="{Binding HasItem, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <Separator Margin="0,14,0,10" />

                    <StackPanel Visibility="{Binding HasItem, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="8" Background="#FF101015" BorderBrush="{StaticResource Brush.BorderSoft}"
                                BorderThickness="1" MinHeight="120" Margin="0,0,0,10">
                            <Image Source="{Binding CurrentItem.PreviewUrl}" Stretch="Uniform" />
                        </Border>

                        <TextBlock Text="{Binding InfoTitle}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding InfoAuthor}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding InfoSize}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding InfoTags}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding InfoStats}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding InfoDescription}" Style="{StaticResource Text.Body}" Margin="0,10,0,0" />

                        <TextBlock Text="{Binding InfoUrl}" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,10,0,0"
                                   TextWrapping="Wrap" Foreground="{StaticResource Brush.Info}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasItem, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <TextBlock Text="尚未获取任何条目信息。" Style="{StaticResource Text.Muted}" />
                    </StackPanel>

                    <Separator Margin="0,14,0,10" />
                    <TextBlock Text="下载通道（按顺序自动尝试）" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" />
                    <TextBlock Text="1. HTTP 直链（Steam UGC）&#x0a;2. Steam 订阅缓存（已订阅时最快最稳）&#x0a;3. steamcmd（需本机安装）"
                               Style="{StaticResource Text.Muted}" FontSize="11.5" Margin="0,6,0,0" />
                    <TextBlock Text="若都失败：在 Steam 中订阅该 Mod，然后回到「下载管理」点击重试。"
                               Style="{StaticResource Text.Muted}" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
