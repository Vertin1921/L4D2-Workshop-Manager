<UserControl x:Class="L4D2ModManager.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:L4D2ModManager.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ProfilesViewModel}"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- 方案列表 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,10,10">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding LiveStateText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Ghost}" Content="🔄 刷新" Command="{Binding RefreshCommand}" />
                        <Button Style="{StaticResource Button.Primary}" Content="✅ 应用所选方案" Margin="8,0,0,0"
                                Command="{Binding ApplySelectedCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ListBox Grid.Row="1" Style="{StaticResource ListBox.Clean}" ItemContainerStyle="{StaticResource ListBoxItem.Clean}"
                     ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected, Mode=TwoWay}" Margin="0,0,10,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card.Reveal}" Padding="14">
                            <Grid>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" />
                                        <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" Background="#26C1272D"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="内置" FontSize="10.5" Foreground="{StaticResource Brush.AccentBright}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"
                                               TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding PresetText}" Style="{StaticResource Text.Muted}" FontSize="11.5" />
                                        <TextBlock Text=" · " Style="{StaticResource Text.Muted}" FontSize="11.5" />
                                        <TextBlock Text="{Binding OverrideText}" Style="{StaticResource Text.Muted}" FontSize="11.5" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Button.Primary}" Content="应用"
                                            Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Button.Ghost}" Content="详情" Margin="6,0,0,0"
                                            Command="{Binding DataContext.EditOverridesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Button.Danger}" Content="删除" Margin="6,0,0,0"
                                            IsEnabled="{Binding IsBuiltIn, Converter={StaticResource InverseBoolean}}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- 右侧：保存当前状态 + 说明 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="保存当前状态为方案" Style="{StaticResource Text.Section}" />
                        <TextBlock Text="把当前所有 Mod 的启用 / 禁用状态保存下来，之后可以一键切换。"
                                   Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                        <TextBlock Text="方案名称" Style="{StaticResource Text.Muted}" Margin="0,12,0,6" />
                        <TextBox Style="{StaticResource TextBox.Dark}"
                                 Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="备注（可选）" Style="{StaticResource Text.Muted}" Margin="0,10,0,6" />
                        <TextBox Style="{StaticResource TextBox.Dark}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 Text="{Binding NewProfileDescription, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource Button.Primary}" Content="💾 保存为新方案" Margin="0,12,0,0"
                                Command="{Binding CaptureCommand}" />
                        <Button Style="{StaticResource Button.Ghost}" Content="⚡ 快速保存（自动命名）" Margin="0,6,0,0"
                                Command="{Binding ImportCurrentCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card.Static}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="内置方案规则" Style="{StaticResource Text.Section}" />
                        <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap">
                            <Run Text="单人模式：" FontWeight="SemiBold" />全部 Mod 启用。
                            <LineBreak />
                            <Run Text="联机模式：" FontWeight="SemiBold" />关闭脚本类 Mod 与互相冲突的 Mod，保留模型 / 材质 / 音频。
                            <LineBreak />
                            <Run Text="写实模式：" FontWeight="SemiBold" />关闭武器类与脚本类 Mod（保留原版枪械手感）。
                            <LineBreak />
                            <Run Text="枪械模式：" FontWeight="SemiBold" />只启用武器与 UI 类 Mod。
                            <LineBreak />
                            <LineBreak />
                            内置方案基于分类与冲突检测结果动态计算，新加入的 Mod 会自动纳入规则；
                            也可以在内置方案基础上应用后，再“保存当前状态”为自定义方案。
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
