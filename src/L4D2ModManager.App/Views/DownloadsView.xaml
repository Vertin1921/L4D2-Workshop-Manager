<UserControl x:Class="L4D2ModManager.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:L4D2ModManager.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DownloadsViewModel}"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Body}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="保存目录：" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding DownloadDirectoryText}" Style="{StaticResource Text.Muted}"
                                   Foreground="{StaticResource Brush.Text}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Ghost}" Content="🧹 清除已完成" Command="{Binding ClearFinishedCommand}" />
                    <Button Style="{StaticResource Button.Ghost}" Content="📁 打开下载目录" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ListBox Style="{StaticResource ListBox.Clean}" ItemContainerStyle="{StaticResource ListBoxItem.Clean}"
                     ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card.Reveal}" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="4" Height="16" CornerRadius="2" Margin="0,0,9,0"
                                                Background="{Binding Status, Converter={StaticResource DownloadStatusBrush}}" />
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="560" VerticalAlignment="Center" />
                                        <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" Background="#26FFFFFF"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                                       Foreground="{Binding Status, Converter={StaticResource DownloadStatusBrush}}" />
                                        </Border>
                                        <Border CornerRadius="4" Padding="6,1" Margin="6,0,0,0" Background="#1F4C8FE0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding ProviderName, Converter={StaticResource NullToVisibility}}">
                                            <TextBlock Text="{Binding ProviderName}" FontSize="10.5" Foreground="{StaticResource Brush.Info}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource Button.Ghost}" Content="暂停" Margin="0,0,6,0"
                                                Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource Button.Ghost}" Content="继续" Margin="0,0,6,0"
                                                Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource Button.Ghost}" Content="重试" Margin="0,0,6,0"
                                                Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource Button.Ghost}" Content="取消" Margin="0,0,6,0"
                                                Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource Button.Icon}" Content="📂" ToolTip="打开文件位置"
                                                Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource Button.Icon}" Content="🔗" ToolTip="复制工坊链接"
                                                Command="{Binding DataContext.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Button.Icon}" Content="✕" ToolTip="从列表移除"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <ProgressBar Style="{StaticResource ProgressBar.Dark}" Minimum="0" Maximum="100"
                                                 Value="{Binding ProgressPercent, Mode=OneWay}" />
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Muted}" FontSize="11.5" />
                                        <TextBlock Text=" · " Style="{StaticResource Text.Muted}" FontSize="11.5" />
                                        <TextBlock Text="{Binding SpeedText}" Style="{StaticResource Text.Muted}" FontSize="11.5"
                                                   Foreground="{StaticResource Brush.Success}" />
                                        <TextBlock Text=" · " Style="{StaticResource Text.Muted}" FontSize="11.5" />
                                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Text.Muted}" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="520" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Muted}" FontSize="11.5"
                                               Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,18,0,0"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasTasks, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <TextBlock Text="⬇" FontSize="42" HorizontalAlignment="Center" Opacity="0.5" />
                <TextBlock Text="没有下载任务" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock Text="在「创意工坊」页面点击「⬇ 下载 Mod」，或在「Mod 管理」中粘贴创意工坊链接。"
                           Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,8,0,0" MaxWidth="460"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
