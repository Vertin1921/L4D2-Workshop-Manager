<UserControl x:Class="L4D2ModManager.App.Views.ConflictsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:L4D2ModManager.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ConflictsViewModel}"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding ScannedText}" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Muted}" Margin="12,0,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="620" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Grid Width="240" Margin="0,0,8,0">
                        <TextBox Style="{StaticResource TextBox.Dark}" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                        <TextBlock Text="🔍 过滤文件 / Mod 名称" Style="{StaticResource Text.Muted}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding FilterText, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                    </Grid>
                    <CheckBox Style="{StaticResource CheckBox.Dark}" Content="只看资源覆盖" VerticalAlignment="Center"
                              ToolTip="模型 / 材质 / 音频 / 地图等会直接互相覆盖的文件（影响最大）"
                              IsChecked="{Binding ShowOnlyHighSeverity}" Margin="0,0,10,0" />
                    <CheckBox Style="{StaticResource CheckBox.Dark}" Content="只看同时启用" VerticalAlignment="Center"
                              ToolTip="当前真正会互相覆盖的冲突"
                              IsChecked="{Binding ShowOnlyActive}" Margin="0,0,10,0" />
                    <CheckBox Style="{StaticResource CheckBox.Dark}" Content="显示内容相同项" VerticalAlignment="Center"
                              ToolTip="CRC32 完全一致的文件：内容一模一样，只是重复打包，不会互相覆盖（默认隐藏）"
                              IsChecked="{Binding ShowIdenticalContent}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource Button.Primary}" Content="🔍 开始检测" Command="{Binding DetectCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ListBox Style="{StaticResource ListBox.Clean}" ItemContainerStyle="{StaticResource ListBoxItem.Clean}"
                     ItemsSource="{Binding Conflicts}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card.Reveal}" Padding="12">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                Background="#33E0A030"
                                Visibility="{Binding IsActiveConflict, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="同时启用" FontSize="10.5" Foreground="{StaticResource Brush.Warning}" />
                        </Border>
                        <Border CornerRadius="4" Padding="6,1" Margin="0,0,8,0" Background="#26FFFFFF"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding KindText}" FontSize="10.5"
                                       Foreground="{Binding Severity, Converter={StaticResource ConflictSeverityBrush}}" />
                        </Border>
                        <TextBlock Text="{Binding InnerPath}" FontFamily="{StaticResource Font.Mono}"
                                   FontSize="12" Foreground="{StaticResource Brush.Text}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="660" />
                                        <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" Background="#26FFFFFF"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Extension}" FontSize="10.5" Foreground="{StaticResource Brush.TextMuted}" />
                                        </Border>
                                        <TextBlock Text="{Binding Count, StringFormat='涉及 {0} 个 Mod'}" Style="{StaticResource Text.Muted}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Button Style="{StaticResource Button.Icon}" Content="📋" HorizontalAlignment="Right"
                                            ToolTip="复制冲突文件路径"
                                            Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Mods}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="7" Padding="8,5" Margin="0,0,8,6" Background="#FF16161D"
                                                    BorderBrush="{StaticResource Brush.BorderSoft}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"
                                                             Fill="{Binding Enabled, Converter={StaticResource EnabledStateBrush}}" />
                                                    <TextBlock Text="{Binding ModName}" FontSize="12"
                                                               Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"
                                                               MaxWidth="240" TextTrimming="CharacterEllipsis" />
                                                    <Button Style="{StaticResource Button.Icon}" Content="保留此项" FontSize="10.5" Margin="8,0,0,0"
                                                            ToolTip="保留该 Mod 并禁用同一冲突中的其他 Mod"
                                                            Command="{Binding DataContext.DisableOthersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource Button.Icon}" Content="禁用" FontSize="10.5" Margin="2,0,0,0"
                                                            Command="{Binding DataContext.DisableModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding Enabled, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Style="{StaticResource Button.Icon}" Content="启用" FontSize="10.5" Margin="2,0,0,0"
                                                            Command="{Binding DataContext.EnableModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding Enabled, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <TextBlock Text="✅" FontSize="42" HorizontalAlignment="Center" Opacity="0.6" />
                <TextBlock Text="没有真实冲突" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock Text="程序会比较所有 Mod 的内部文件；CRC32 一致（内容完全相同）的重复文件、addoninfo/addonimage 以及内置的共享脚本库都会被判为无影响。&#x0a;若仍有大量重复文件想自己排除，可在「设置 → 冲突检测」里添加忽略关键字。"
                           Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,8,0,0" MaxWidth="560"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
