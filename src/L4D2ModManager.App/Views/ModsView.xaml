<UserControl x:Class="L4D2ModManager.App.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:L4D2ModManager.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ModsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="A" Command="{Binding SelectAllCommand}" />
        <KeyBinding Modifiers="Control" Key="D" Command="{Binding SelectNoneCommand}" />
        <KeyBinding Modifiers="Control" Key="I" Command="{Binding InvertSelectionCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 第一行：搜索 / 排序 / 过滤 ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox Style="{StaticResource TextBox.Dark}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                    <TextBlock Text="🔍  搜索名称 / 作者 / 分类 / 工坊 ID"
                               Style="{StaticResource Text.Muted}" Margin="12,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                    <Button Style="{StaticResource Button.Icon}" Content="✕" HorizontalAlignment="Right"
                            Margin="0,0,4,0" Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding SearchText, Converter={StaticResource NullToVisibility}}" />
                </Grid>

                <ComboBox Grid.Column="1" Style="{StaticResource ComboBox.Dark}" Width="168" Margin="8,0,0,0"
                          ItemContainerStyle="{StaticResource ComboBoxItem.Dark}"
                          ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" DisplayMemberPath="Text" ToolTip="排序方式" />

                <ComboBox Grid.Column="2" Style="{StaticResource ComboBox.Dark}" Width="140" Margin="8,0,0,0"
                          ItemContainerStyle="{StaticResource ComboBoxItem.Dark}"
                          ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Text" ToolTip="按分类过滤" />

                <ComboBox Grid.Column="3" Style="{StaticResource ComboBox.Dark}" Width="106" Margin="8,0,0,0"
                          ItemContainerStyle="{StaticResource ComboBoxItem.Dark}"
                          ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}" DisplayMemberPath="Text" ToolTip="按启用状态过滤" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="10,0,0,0">
                    <CheckBox Style="{StaticResource CheckBox.Dark}" Content="只看冲突" VerticalAlignment="Center"
                              IsChecked="{Binding ShowOnlyConflicts}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource Button.Ghost}" Command="{Binding RefreshCommand}"
                            ToolTip="刷新列表与缩略图（扫描/加载时图标会旋转）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="RefreshSpin">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                From="0" To="360" Duration="0:0:0.9" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="RefreshSpin" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="刷新" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 第二行：批量操作 / 链接添加 ============ -->
        <Border Grid.Row="1" Style="{StaticResource Card.Static}" Padding="12,9" Margin="0,0,0,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Style="{StaticResource CheckBox.Minimal}" IsChecked="{Binding AllSelected, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="2,0,8,0" ToolTip="全选 / 取消全选（也可以按 Ctrl+A）" />
                    <Button Style="{StaticResource Button.Ghost}" Content="全选" Margin="0,0,6,0" Padding="10,5" FontSize="12"
                            ToolTip="选中当前列表的全部 Mod（Ctrl+A）" Command="{Binding SelectAllCommand}" />
                    <Button Style="{StaticResource Button.Ghost}" Content="取消选择" Margin="0,0,6,0" Padding="10,5" FontSize="12"
                            Command="{Binding SelectNoneCommand}" />
                    <Button Style="{StaticResource Button.Ghost}" Content="反选" Margin="0,0,14,0" Padding="10,5" FontSize="12"
                            Command="{Binding InvertSelectionCommand}" />
                    <Button Style="{StaticResource Button.Ghost}" Content="启用所选" Margin="0,0,6,0" Command="{Binding EnableSelectedCommand}" />
                    <Button Style="{StaticResource Button.Ghost}" Content="禁用所选" Margin="0,0,10,0" Command="{Binding DisableSelectedCommand}" />
                    <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox Style="{StaticResource TextBox.Dark}" Width="300" VerticalAlignment="Center"
                             Text="{Binding LinkInput, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                             ToolTip="粘贴 Steam 创意工坊链接或 ID，例如 https://steamcommunity.com/sharedfiles/filedetails/?id=123456789" />
                    <Button Style="{StaticResource Button.Primary}" Content="➕ 添加 Mod" Margin="8,0,0,0"
                            Command="{Binding AddLinkCommand}" />
                    <Button Style="{StaticResource Button.Ghost}" Content="📂 添加 Mod 文件" Margin="8,0,0,0"
                            ToolTip="选择本机的 .vpk 文件安装（以管理员身份运行时拖放会被 Windows 阻止，请用这个按钮）"
                            Command="{Binding DataContext.AddVpkFilesCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 提权提示：管理员权限下拖放会被系统阻止 ============ -->
        <Border Grid.Row="2" Margin="0,0,0,8" CornerRadius="8" Padding="12,8"
                Background="#264C8FE0" BorderBrush="#554C8FE0" BorderThickness="1"
                Visibility="{Binding DataContext.ShowElevatedDragDropHint, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ℹ" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.Info}" />
                <TextBlock Text="{Binding DataContext.ElevatedDragDropHintText, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource Text.Body}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- ============ 列表 ============ -->
        <Grid Grid.Row="3">
            <ListBox x:Name="ModList" Style="{StaticResource ListBox.Clean}"
                     ItemContainerStyle="{StaticResource ListBoxItem.Clean}"
                     ItemsSource="{Binding Items}"
                     ScrollViewer.CanContentScroll="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardRoot" Style="{StaticResource Card.Item}" Padding="10" ToolTip="{Binding ToolTipText}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="CardLift" Y="0" />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" Style="{StaticResource CheckBox.Minimal}" VerticalAlignment="Center"
                                          Margin="2,0,12,0" IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                <!-- 缩略图 + 分类色条 -->
                                <Grid Grid.Column="1" Width="116" Height="72" Margin="0,0,14,0">
                                    <Border CornerRadius="7" Background="#FF0F0F14"
                                            BorderBrush="{StaticResource Brush.BorderSoft}" BorderThickness="1">
                                        <!-- 缩略图已按需求移除，仅保留分类色条与分类徽章 -->
                                    </Border>
                                    <Border x:Name="AccentBar" Width="5" HorizontalAlignment="Left" Margin="0,6" CornerRadius="2.5"
                                            Opacity="0.5"
                                            Background="{Binding Model.Category, Converter={StaticResource CategoryBrush}}" />
                                    <TextBlock Text="🖼" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Opacity="0.35"
                                               Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="4"
                                            CornerRadius="4" Padding="5,1" Background="#CC0A0A0E"
                                            Visibility="{Binding HasWorkshopId, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="工坊" FontSize="9.5" Foreground="{StaticResource Brush.Info}" />
                                    </Border>
                                </Grid>

                                <!-- 信息 -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="480" VerticalAlignment="Center" />
                                        <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Background="#2222C55E">
                                            <TextBlock Text="{Binding StateText}" FontSize="10.5"
                                                       Foreground="{Binding IsEnabled, Converter={StaticResource EnabledStateBrush}}" />
                                        </Border>
                                        <Border CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                Background="#33E0A030"
                                                Visibility="{Binding HasConflict, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding ConflictText}" FontSize="10.5" Foreground="{StaticResource Brush.Warning}" />
                                        </Border>
                                        <Border CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                Background="#33E05252"
                                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="⚠ 解析异常" FontSize="10.5" Foreground="{StaticResource Brush.Danger}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding AuthorLine}" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />

                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}"
                                               Foreground="{StaticResource Brush.TextDim}" Margin="0,3,0,0"
                                               MaxHeight="30" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Style="{StaticResource Button.Chip}" Content="{Binding CategoryText}" FontSize="11"
                                                Padding="8,1" Margin="0,0,4,0"
                                                Command="{Binding DataContext.FilterByCategoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="点击只看该类型的 Mod（再点一次取消筛选）" />
                                        <TextBlock Text=" · " Style="{StaticResource Text.Muted}" FontSize="11.5" />
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.Muted}" FontSize="11.5" />
                                        <TextBlock Text=" · " Style="{StaticResource Text.Muted}" FontSize="11.5" />
                                        <TextBlock Text="{Binding WorkshopText}" Style="{StaticResource Text.Muted}" FontSize="11.5" />
                                        <TextBlock Text=" · " Style="{StaticResource Text.Muted}" FontSize="11.5" />
                                        <TextBlock Text="{Binding AddedText}" Style="{StaticResource Text.Muted}" FontSize="11.5" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 操作按钮 -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Button Style="{StaticResource Button.Ghost}" Content="{Binding ToggleText}" MinWidth="64"
                                            ToolTip="启用 / 禁用（仅重命名文件后缀，不修改内容）"
                                            Command="{Binding Owner.ToggleCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Button.Icon}" Content="📂" Margin="6,0,0,0" ToolTip="打开所在目录"
                                            Command="{Binding Owner.OpenFolderCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Button.Icon}" Content="ℹ" Margin="2,0,0,0" ToolTip="查看详情"
                                            Command="{Binding Owner.DetailsCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Button.Danger}" Content="删除" Margin="8,0,0,0"
                                            ToolTip="删除 VPK、缩略图缓存与数据库记录"
                                            Command="{Binding Owner.DeleteCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>

                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="启用 / 禁用"
                                              Command="{Binding Owner.ToggleCommand}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="打开所在目录"
                                              Command="{Binding Owner.OpenFolderCommand}"
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="复制文件路径"
                                              Command="{Binding Owner.CopyPathCommand}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="复制创意工坊链接"
                                              Command="{Binding Owner.CopyWorkshopCommand}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="查看详情"
                                              Command="{Binding Owner.DetailsCommand}"
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="删除 Mod"
                                              Command="{Binding Owner.DeleteCommand}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                        </Border>

                        <!-- 悬停动画：卡片轻微上移 + 分类色条点亮（只改 RenderTransform 与 Opacity） -->
                        <DataTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter" SourceName="CardRoot">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardLift" Storyboard.TargetProperty="Y"
                                                         To="-2" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.24" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave" SourceName="CardRoot">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardLift" Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity"
                                                         To="0.5" Duration="0:0:0.26" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空列表提示 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <TextBlock Text="🎮" FontSize="42" HorizontalAlignment="Center" Opacity="0.5" />
                <TextBlock Text="还没有 Mod" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock Text="在「设置」中添加 addons 目录，然后点击左上角「重新扫描」；也可直接把 .vpk 拖进窗口。"
                           Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,8,0,0" MaxWidth="460"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
