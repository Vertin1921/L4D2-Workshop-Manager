<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPF 前端：Left 4 Dead 2 Mod Manager
    · 目标框架 net8.0-windows，启用 WPF
    · 显式 x64（PlatformTarget），配合 Release 生成 64 位可执行文件
    · 内置 WebView2 用于程序内部浏览 Steam 创意工坊（不打开外部浏览器）
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>L4D2ModManager.App</RootNamespace>
    <AssemblyName>L4D2ModManager</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF SDK 的隐式 using 集合不含 System.IO / System.Net.Http，这里显式补充 -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\L4D2ModManager.Core\L4D2ModManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />

    <!-- 内置角色头像：安装后默认就有图（离线可用），用户可用数据目录里的图片覆盖 -->
    <Resource Include="Assets\avatars\*.png" />
  </ItemGroup>

</Project>
