<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         调色板：Left 4 Dead 2（黑 / 深灰 / 暗红）+ macOS 质感
         ============================================================ -->
    <Color x:Key="Color.Window">#F20B0B0E</Color>
    <Color x:Key="Color.Panel">#FF111116</Color>
    <Color x:Key="Color.PanelAlt">#FF16161D</Color>
    <Color x:Key="Color.Card">#FF1A1A22</Color>
    <Color x:Key="Color.CardHover">#FF23232E</Color>
    <Color x:Key="Color.Border">#FF2A2A35</Color>
    <Color x:Key="Color.BorderSoft">#FF212129</Color>

    <Color x:Key="Color.Accent">#FFC1272D</Color>
    <Color x:Key="Color.AccentBright">#FFE23B3B</Color>
    <Color x:Key="Color.AccentDeep">#FF7A1519</Color>
    <Color x:Key="Color.AccentGlow">#33E23B3B</Color>

    <Color x:Key="Color.Text">#FFEDEDF2</Color>
    <Color x:Key="Color.TextMuted">#FF9A9AA8</Color>
    <Color x:Key="Color.TextDim">#FF6E6E7C</Color>

    <Color x:Key="Color.Success">#FF4CAF6E</Color>
    <Color x:Key="Color.Warning">#FFE0A030</Color>
    <Color x:Key="Color.Danger">#FFE05252</Color>
    <Color x:Key="Color.Info">#FF4C8FE0</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}" />
    <SolidColorBrush x:Key="Brush.PanelAlt" Color="{StaticResource Color.PanelAlt}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}" />
    <SolidColorBrush x:Key="Brush.CardHover" Color="{StaticResource Color.CardHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderSoft" Color="{StaticResource Color.BorderSoft}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentBright" Color="{StaticResource Color.AccentBright}" />
    <SolidColorBrush x:Key="Brush.AccentDeep" Color="{StaticResource Color.AccentDeep}" />
    <SolidColorBrush x:Key="Brush.AccentGlow" Color="{StaticResource Color.AccentGlow}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="{StaticResource Color.TextDim}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />
    <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent" />

    <!-- 分类色条 -->
    <SolidColorBrush x:Key="Brush.Category.Weapon" Color="#FFC1272D" />
    <SolidColorBrush x:Key="Brush.Category.Character" Color="#FF4C8FE0" />
    <SolidColorBrush x:Key="Brush.Category.Audio" Color="#FF9B5CD6" />
    <SolidColorBrush x:Key="Brush.Category.Map" Color="#FF4CAF6E" />
    <SolidColorBrush x:Key="Brush.Category.Script" Color="#FFE0A030" />
    <SolidColorBrush x:Key="Brush.Category.Ui" Color="#FF2FB3B3" />
    <SolidColorBrush x:Key="Brush.Category.Other" Color="#FF6E6E7C" />

    <LinearGradientBrush x:Key="Brush.WindowBackdrop" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E60D0D12" Offset="0" />
        <GradientStop Color="#F00A0A0D" Offset="0.55" />
        <GradientStop Color="#F21A0A0C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.TitleBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CC14141A" Offset="0" />
        <GradientStop Color="#B30D0D12" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="Font.Ui">Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Mono">Consolas, Cascadia Mono, monospace</FontFamily>

    <!-- ============================================================
         文本
         ============================================================ -->
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    </Style>

    <Style x:Key="Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Text.Section" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Margin" Value="0,4,0,6" />
    </Style>

    <!-- ============================================================
         卡片 / 分组
         ============================================================ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Card.Static" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource Brush.PanelAlt}" />
    </Style>

    <!-- ============================================================
         按钮
         ============================================================ -->
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <!-- 轻微过冲（BackEase），接近 macOS 的弹性反馈 -->
                                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.045" Duration="0:0:0.36">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase Amplitude="0.5" EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.045" Duration="0:0:0.36">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase Amplitude="0.5" EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.42">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.42">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseDown">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.965" Duration="0:0:0.13" />
                                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.965" Duration="0:0:0.13" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseUp">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.035" Duration="0:0:0.22" />
                                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.035" Duration="0:0:0.22" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.CardHover}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentBright}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="#331E0B0D" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentDeep}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
    </Style>

    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSoft}" />
    </Style>

    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- 标题栏按钮（旧样式，保留兼容） -->
    <Style x:Key="Button.Caption" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    </Style>

    <!--
      macOS 风格「交通灯」窗口按钮：纯色圆点 + 悬停显示符号（✕ / — / ⤢）
    -->
    <Style x:Key="Button.TrafficLight" TargetType="Button">
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="DotHost" Width="13" Height="13" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="DotScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}" Stroke="#40000000" StrokeThickness="0.6" />
                        <TextBlock x:Name="GlyphText" Text="{TemplateBinding Content}"
                                   FontFamily="Segoe UI" FontSize="8" FontWeight="Bold" Foreground="#59000000"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 鼠标进入整个按钮组（父 StackPanel 的 Tag 被代码设为 Hover）→ 三个符号一起淡入 -->
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="Hover">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="GlyphText" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.34" />
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1.12" Duration="0:0:0.34" />
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1.12" Duration="0:0:0.34" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="GlyphText" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.38" />
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.38" />
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.38" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GlyphText" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Dot" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Dot" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 侧边栏导航项（选中指示条由 MainWindow 里单独的一条滑块负责，这里只做背景与文字变化） -->
    <Style x:Key="Button.Nav" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="6,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="9">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#14FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="Root" Property="Background" Value="#26C1272D" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分类 / 过滤胶囊 -->
    <Style x:Key="Button.Chip" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="14" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.AccentBright}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         输入控件
         ============================================================ -->
    <Style x:Key="TextBox.Dark" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.AccentBright}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Background" Value="#FF14141A" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PasswordBox.Dark" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.AccentBright}" />
        <Setter Property="Background" Value="#FF14141A" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
    </Style>

    <Style x:Key="CheckBox.Dark" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box" Width="17" Height="17" CornerRadius="5"
                                Background="#FF14141A" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="M 3,8 L 6.5,11.5 L 13,4" Stroke="White" StrokeThickness="2"
                                  Visibility="Collapsed" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.AccentBright}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.AccentBright}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 三态复选框（列表多选表头用） -->
    <Style x:Key="CheckBox.Minimal" TargetType="CheckBox" BasedOn="{StaticResource CheckBox.Dark}">
        <Setter Property="Content" Value="" />
    </Style>

    <Style x:Key="ComboBox.Dark" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Background" Value="#FF14141A" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Root" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" />
                        <ContentPresenter Margin="10,7,26,7" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <Path x:Name="Arrow" Data="M 0,0 L 5,5 L 10,0" Stroke="{StaticResource Brush.TextMuted}"
                              StrokeThickness="1.6" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,9,0" />
                        <ToggleButton x:Name="Toggle" Background="Transparent" BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      ClickMode="Press" Focusable="False" Opacity="0" />
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade" Focusable="False">
                            <Border Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320"
                                    CornerRadius="8" Background="{StaticResource Brush.PanelAlt}"
                                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboBoxItem.Dark" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="3,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#1FFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.AccentDeep}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         滚动条
         ============================================================ -->
    <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Root" CornerRadius="4" Background="#40FFFFFF" Margin="3,0" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBar.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="10" />
                            <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         进度条
         ============================================================ -->
    <Style x:Key="ProgressBar.Dark" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource Brush.AccentBright}" />
        <Setter Property="Background" Value="#FF23232C" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="3" Background="{TemplateBinding Background}" ClipToBounds="True">
                        <Grid>
                            <Rectangle x:Name="PART_Track" />
                            <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                       Fill="{TemplateBinding Foreground}" RadiusX="3" RadiusY="3" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProgressBar.Indeterminate" TargetType="ProgressBar" BasedOn="{StaticResource ProgressBar.Dark}">
        <Setter Property="IsIndeterminate" Value="True" />
    </Style>

    <!-- ============================================================
         列表 / 列表项
         ============================================================ -->
    <Style x:Key="ListBox.Clean" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <!-- 预取一页内容，滚动时不会出现空白再填充的抖动 -->
        <Setter Property="VirtualizingPanel.CacheLength" Value="1" />
        <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page" />
        <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="ListBoxItem.Clean" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分类胶囊列表（横向） -->
    <Style x:Key="ListBox.Header" TargetType="ListBox" BasedOn="{StaticResource ListBox.Clean}">
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- ============================================================
         其他
         ============================================================ -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#F01A1A22" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" CornerRadius="7" Padding="9,6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource Brush.BorderSoft}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        列表卡片样式。
        注意：这里刻意只做"颜色/边框"级别的悬停反馈，不做逐项的进入动画：
        列表启用了虚拟化，逐项 Loaded 动画在快速滚动时会不断重放，是卡顿的主要来源。
        需要运动感的地方（卡片悬停位移、页面切换）在各自的 DataTemplate / 窗口层用
        RenderTransform + Opacity 实现，完全不触发布局计算。
    -->
    <Style x:Key="Card.Reveal" TargetType="Border" BasedOn="{StaticResource Card}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.CardHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentGlow}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 列表项卡片（与 Card.Reveal 同义，语义化命名） -->
    <Style x:Key="Card.Item" TargetType="Border" BasedOn="{StaticResource Card.Reveal}" />

    <!-- 缩略图：低质量插值，滚动时明显更快（缩略图尺寸远小于显示尺寸，画质差异不可见） -->
    <Style x:Key="Image.Thumb" TargetType="Image">
        <Setter Property="Stretch" Value="UniformToFill" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="LowQuality" />
    </Style>

    <!-- 列表整体进入动画（一次，作用于容器而不是每个列表项） -->
    <Style x:Key="Content.Transition" TargetType="ContentPresenter">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="10" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.42" />
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                         To="0" Duration="0:0:0.50">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
