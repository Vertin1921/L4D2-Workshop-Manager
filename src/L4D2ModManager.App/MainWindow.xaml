<Window x:Class="L4D2ModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:L4D2ModManager.App.ViewModels"
        xmlns:views="clr-namespace:L4D2ModManager.App.Views"
        Title="Left 4 Dead 2 Mod Manager"
        Width="1320" Height="860" MinWidth="1020" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource Font.Ui}"
        AllowDrop="True"
        DragEnter="Window_DragEnter" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop"
        Closing="Window_Closing" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 视图模型 → 视图 的映射统一放在 App.xaml 的应用级资源里，
             这样自检程序（在窗口之外创建 ContentControl）也能校验每个页面都有对应视图。 -->
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
            CornerRadius="10" Background="{StaticResource Brush.WindowBackdrop}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- ================= 标题栏（Windows 11 风格：左侧标题 + 右侧窗口按钮） ================= -->
            <Grid x:Name="TitleBar" Grid.Row="0" Height="40" Background="{StaticResource Brush.TitleBar}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="5" Height="18" CornerRadius="2.5" Background="{StaticResource Brush.Accent}" Margin="0,0,10,0" />
                    <TextBlock Text="LEFT 4 DEAD 2" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Brush.Text}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="MOD MANAGER" FontSize="13" FontWeight="Normal" Margin="8,0,0,0"
                               Foreground="{StaticResource Brush.AccentBright}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Button.Caption}" Content="—" Click="Minimize_Click" ToolTip="最小化" />
                    <Button Style="{StaticResource Button.Caption}" Content="▢" Click="Maximize_Click" ToolTip="最大化 / 还原（F11 全屏）" />
                    <Button Style="{StaticResource Button.Caption}" Content="✕" Click="Close_Click" ToolTip="关闭" />
                </StackPanel>
            </Grid>

            <!-- ================= 主体 ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 侧边栏 -->
                <Border Grid.Column="0" Background="#B30E0E14" BorderBrush="{StaticResource Brush.BorderSoft}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="12,6,12,14">
                            <Button Style="{StaticResource Button.Primary}" Content="🎮  启动游戏" Padding="12,9" Margin="0,0,0,6"
                                    Command="{Binding LaunchGameCommand}" ToolTip="{Binding LaunchGameToolTip}" />
                            <Button Style="{StaticResource Button.Ghost}" Content="🎮  启动游戏（-insecure）" Padding="12,8" Margin="0,0,0,6"
                                    Command="{Binding LaunchGameInsecureCommand}"
                                    ToolTip="以 -insecure 启动：关闭 VAC，联机 Mod / 测试用，无法进入官方服" />
                            <TextBlock Text="{Binding LaunchStatusText}" Style="{StaticResource Text.Muted}"
                                       Margin="2,0,0,8" TextWrapping="Wrap" />
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding ScanAllCommand}"
                                    Content="🔄  重新扫描" Padding="12,9" />
                            <TextBlock Text="{Binding ModSummary}" Style="{StaticResource Text.Muted}"
                                       Margin="2,10,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Muted}"
                                       Foreground="{StaticResource Brush.TextDim}" Margin="2,4,0,0" TextWrapping="Wrap" />
                            <Separator Margin="0,10,0,8" />
                            <Button Style="{StaticResource Button.Ghost}" Content="💾  保存配置" Command="{Binding SaveCommand}" Margin="0,0,0,6" />
                            <Button Style="{StaticResource Button.Ghost}" Content="{Binding AcrylicButtonText}" Command="{Binding ToggleAcrylicCommand}" />
                        </StackPanel>

                        <Grid x:Name="NavHost" Margin="0,10,0,0" VerticalAlignment="Top">
                            <!-- macOS 风格滑动指示条：随选中项平滑移动 -->
                            <Border x:Name="NavIndicator" Width="3" Height="22" CornerRadius="2"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,0,0,0"
                                    Background="{StaticResource Brush.Accent}" Opacity="0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="NavIndicatorTransform" Y="0" />
                                </Border.RenderTransform>
                            </Border>

                            <ItemsControl x:Name="NavList" ItemsSource="{Binding NavItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Button.Nav}" Tag="{Binding ActiveTag}"
                                                Command="{Binding DataContext.SelectNavCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" FontSize="15" Width="28" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="13.5" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                                                               Foreground="{StaticResource Brush.TextDim}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- 内容区 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,16,20,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource Text.Title}" />
                            <Border Height="18" Width="1" Background="{StaticResource Brush.Border}" Margin="12,0" />
                            <TextBlock Text="{Binding CurrentSubtitle}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Ghost}" Content="⚠ 检测冲突" Margin="0,0,8,0"
                                    Command="{Binding DetectConflictsCommand}" />
                            <Button Style="{StaticResource Button.Ghost}" Content="📁 下载目录"
                                    Command="{Binding OpenDownloadFolderCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- 未提权提示条（可一键提权重启 / 不再提示） -->
                    <Border Grid.Row="1" Margin="20,0,20,10" CornerRadius="8" Padding="12,9"
                            Background="#33E0A030" BorderBrush="#66E0A030" BorderThickness="1"
                            Visibility="{Binding ShowElevationBanner, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,220,0">
                                <TextBlock Text="🛡" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ElevationBannerText}" Style="{StaticResource Text.Body}"
                                           FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource Button.Primary}" Content="以管理员身份重启"
                                        Padding="10,5" FontSize="12" Command="{Binding RestartElevatedCommand}" />
                                <Button Style="{StaticResource Button.Ghost}" Content="不再提示" Margin="8,0,0,0"
                                        Padding="10,5" FontSize="12" Command="{Binding DismissElevationCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ContentControl x:Name="PageHost" Grid.Row="2" Content="{Binding CurrentPage}" Margin="20,0,20,14" />
                </Grid>
            </Grid>

            <!-- ================= 状态栏 ================= -->
            <Border Grid.Row="2" Background="#B30C0C11" BorderBrush="{StaticResource Brush.BorderSoft}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}" FontSize="11.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConflictBadgeText}" Style="{StaticResource Text.Muted}" FontSize="11.5" Margin="0,0,14,0" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Text.Muted}" FontSize="11.5"
                                   Foreground="{StaticResource Brush.TextDim}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 拖放提示遮罩 ================= -->
            <Grid x:Name="DropOverlay" Grid.RowSpan="3" Background="#CC0A0A0D" Visibility="Collapsed">
                <Border BorderBrush="{StaticResource Brush.Accent}" BorderThickness="2" CornerRadius="10" Margin="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⬇" FontSize="46" HorizontalAlignment="Center" Foreground="{StaticResource Brush.AccentBright}" />
                        <TextBlock Text="松开鼠标即可安装 Mod" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="支持 .vpk 文件，将自动复制到下载目录并加入列表"
                                   Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
