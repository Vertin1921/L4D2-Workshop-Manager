<Window x:Class="L4D2ModManager.App.Dialogs.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="请稍候" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize" ShowInTaskbar="True"
        Background="{StaticResource Brush.Background}"
        FontFamily="{StaticResource Font.Ui}"
        Topmost="True">

    <Border Padding="22,18" Background="{StaticResource Brush.Background}">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="正在处理…" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource Brush.Text}" />
            <TextBlock x:Name="StatusText" Text="准备中…" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextMuted}" />
            <ProgressBar x:Name="Progress" Style="{StaticResource ProgressBar.Dark}" Height="6" Margin="0,14,0,0"
                         Minimum="0" Maximum="100" Value="0" />
            <TextBlock x:Name="PercentText" Text="0%" Margin="0,8,0,0" HorizontalAlignment="Right"
                       Foreground="{StaticResource Brush.TextDim}" FontSize="11.5" />
        </StackPanel>
    </Border>
</Window>
