<Window x:Class="L4D2ModManager.App.Dialogs.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="L4D2 Mod Manager"
        SizeToContent="Height"
        Width="470"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        Background="{StaticResource Brush.WindowBackdrop}"
        FontFamily="{StaticResource Font.Ui}">

    <Border x:Name="SheetRoot" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="12" Background="#F214141A">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SheetTransform" Y="-24" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Height="42" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="4" Height="16" CornerRadius="2" Background="{StaticResource Brush.Accent}" Margin="0,0,9,0" />
                    <TextBlock x:Name="TitleText" Text="提示" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="CloseButton" Style="{StaticResource Button.Caption}" Content="✕"
                        HorizontalAlignment="Right" Click="Cancel_Click" />
            </Grid>

            <!-- 内容 -->
            <StackPanel Grid.Row="1" Margin="18,4,18,14">
                <TextBlock x:Name="MessageText" Style="{StaticResource Text.Body}" FontSize="13.5" />

                <Border x:Name="DetailsPanel" Style="{StaticResource Card.Static}" Margin="0,12,0,0" Visibility="Collapsed">
                    <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="DetailsText" Style="{StaticResource Text.Muted}"
                                   FontFamily="{StaticResource Font.Mono}" FontSize="11.5" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>

                <StackPanel x:Name="InputPanel" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="InputLabel" Style="{StaticResource Text.Muted}" Margin="0,0,0,6" />
                    <TextBox x:Name="InputBox" Style="{StaticResource TextBox.Dark}" />
                </StackPanel>

                <StackPanel x:Name="ChoicePanel" Margin="0,14,0,0" Visibility="Collapsed">
                    <ComboBox x:Name="ChoiceBox" Style="{StaticResource ComboBox.Dark}"
                              ItemContainerStyle="{StaticResource ComboBoxItem.Dark}" />
                </StackPanel>
            </StackPanel>

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,0,18,16">
                <Button x:Name="ExtraButton" Style="{StaticResource Button.Ghost}" Content="复制详情"
                        Margin="0,0,8,0" Visibility="Collapsed" Click="Extra_Click" />
                <Button x:Name="CancelButton" Style="{StaticResource Button.Ghost}" Content="取消"
                        Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="OkButton" Style="{StaticResource Button.Primary}" Content="确定" Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
